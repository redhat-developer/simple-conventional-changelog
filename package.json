{
  "name": "simple-conventional-changelog",
  "version": "0.0.12",
  "description": "Simple action to create changelog using conventional commits",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "ncc build src/index.ts --source-map --minify",
    "clean": "rm -rf out/ dist/",
    "test": "tsc -p . && node --test \"test/*.test.js\""
  },
  "author": "Luca Stocchi",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "compare-versions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.4.2"
  }
}
